# Frontend (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Optional. Leave unset for local development; production can override if the frontend is served from a different origin.
VITE_API_BASE_URL=
# Optional. Used only if you want Vite dev to proxy /api to a non-default local backend.
VITE_API_PROXY_TARGET=
# Optional. Only set this if you intentionally want browser-side TMDB access.
VITE_TMDB_READ_ACCESS_TOKEN=

# Backend / serverless
FIREBASE_SERVICE_ACCOUNT_JSON=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TMDB_READ_ACCESS_TOKEN=

# Set to "true" to enable the shared "Demo" session (uid: demo-user) so
# visitors can try the app without Firebase sign-in. Vite dev enables this
# automatically; set it explicitly in your production environment if you want
# the demo to work there too. The demo profile is shared and publicly writable.
ALLOW_DEMO_AUTH=false

# ---------------------------------------------------------------------------
# Recommendation tuning
# ---------------------------------------------------------------------------

# How strongly to boost popular movies in recommendations (0-1).
#   0     = pure collaborative filtering, no popularity bias
#   0.2   = moderate boost (default) — popular movies get up to 10% lift
#   0.5   = strong boost — popularity significantly influences rankings
#   1.0   = max boost — popular movies can get up to 50% lift
RECS_POPULARITY_WEIGHT=0.35

# How heavily the "one-at-a-time" pick favors the best matches.
# Weight = RECS_RANDOM_DECAY^rank (rank 1 = best match), a geometric decay.
#   0.5   = default — #1 ~50%, #2 ~25%, #3 ~12.5% (top-3 ~87.5%)
#   0.8   = gentler — #1 ~20%, top-10 ranks ~90% combined
#   0.3   = harsher — #1 ~70% of the time
RECS_RANDOM_DECAY=0.5

# ---------------------------------------------------------------------------
# Metadata cache crawler settings (npm run refresh-metadata)
# ---------------------------------------------------------------------------

# Incremental mode: skip movies already in the database.
# Set to "true" for subsequent runs after the first full crawl.
INCREMENTAL=false

# Year-range partition spec for the TMDB Discover API.
# Each partition gets its own 10k-result limit from TMDB, dramatically
# increasing the number of unique movies you can discover.
# Format: "START-END:strategy,START-END:strategy,..."
#   decade  = 10-year buckets
#   5year   = 5-year buckets
#   year    = 1-year buckets
# Example: cover most of cinema history
# TMDB_YEAR_RANGES=1900-1969:decade,1970-1999:5year,2000-2004:year,2005-2009:year,2010-2014:year,2015-2019:year,2020-2026:year
# When unset or empty, a single all-encompassing bucket is used (legacy behavior).
TMDB_YEAR_RANGES=

# Maximum total movies to discover across all partitions.
# With ~1.7KB per minified record, ~280k records will fill ~450MB.
TMDB_METADATA_LIMIT=280000

# Pages to fetch per year-range bucket.
# TMDB returns up to 500 pages (10k movies) per query; 50 pages (~1k movies)
# per bucket is a good balance between coverage and API efficiency.
TMDB_PAGES_PER_BUCKET=50

# Soft byte-budget cap for the local JSON cache.
# The crawler stops adding new records when this limit is approached.
# Default 450000000 (~450MB) — leaves ~50MB headroom under a 500MB ceiling.
TMDB_BYTE_BUDGET=450000000

# Supabase upsert batch size (number of rows per upsert call).
SUPABASE_BATCH_SIZE=100
